---
interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root { font-family: system-ui, sans-serif; color: #222; background: #fff; }
  body { margin: 0; }
  main { width: min(960px, calc(100% - 32px)); margin: 48px auto; }
  a { color: inherit; }
  article img { max-width: 100%; height: auto; }
</style>
